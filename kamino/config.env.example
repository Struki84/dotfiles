# Kamino server settings. Copy to config.env (gitignored) and adjust:
#   cp config.env.example config.env && nano config.env

HOSTNAME_TARGET="kamino"

# Synology "geonosis", mounted over SMB (the same way the old Mac did it).
# Use the IP, not geonosis.local: mDNS resolves to an IPv6 link-local address
# first and may not be ready at boot. Reserve this IP in the router's DHCP.
NAS_HOST="192.168.1.9"

# Synology account used to mount the shares (the one the Mac logs in with).
# The password is NOT stored here: setup.sh asks for it once and saves it to
# /etc/kamino-nas.credentials (root-only).
NAS_USERNAME="simun"

NAS_SHARES="movies tv music"         # Synology shared folder names, space-separated (case-sensitive)
MOUNT_ROOT="/mnt/nas"                # each share mounts at $MOUNT_ROOT/<share>

# setup.sh prepends credentials=/etc/kamino-nas.credentials,uid=plex,gid=plex
NAS_MOUNT_OPTIONS="file_mode=0644,dir_mode=0755,iocharset=utf8,_netdev,nofail,x-systemd.automount,x-systemd.mount-timeout=30"

INSTALL_T2_REPO="false"              # optional T2 Mac support apt repos (no packages installed)
